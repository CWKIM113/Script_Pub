'* CALCULATE D2O MASS DISPLACED TO PRESSURIZER'/
 
'CALCULATE', 'WD'/ WD = D2O MASS DISPLACED TO PRESSURIZER
'ENTER'/                (LBM)
   'WTM', -1.0/
   'CONSTANT(238070)'/ ** Should Be Checked or Corrected Based on the Mass(WTM) Obtained
   /                   ** from Tuning to Get the Nominal Pressurizer Level (12.48 m) at 100% FP
'STORE'/               ** PS-86-401, p.4-10 = 236942
/
 
'* CALCULATE CHANGE IN PRESSURIZER LEVEL'/
 
'CALCULATE','VD'/     VD = VOLUME OF D2O DISPLACED TO PRESSURIZER (FT***3)
'ENTER'/               ** from 86-PS-401, p.4-10
   'WD'/
   /
'MULTIPLY'/
   'VPF'/
   /
'STORE'/
/
 
'CALCULATE', 'LX'/    ** from 86-PS-401, p.4-10
'ENTER'/
   'VD'/
   /
'DIVIDE'/
   'CONSTANT(108.86)'/
   /
'STORE'/
/ NO APPLICATION POINTS
 
'CONTROL DEVICE', 'LPSET1'/  NORMAL PRESSURIZER LEVEL CONTROL
'P', 1.0,,,,,/
   5.16,13.91 /      **  Change from 3.96, 13.71 Based on 86-PS-401, p.4-12
   'LX', 1.09/
   'CONSTANT(5.16)'/
   /
/
 
'IF','LPSET4'/** LOC4P PRESSURIZER LEVEL SETPOINT
 12.48/       **  Change from 12.28
  'IF 102LTCL4 THEN'/
   'CONSTANT(6.66)'/ **  Change from 6.6 Based on 86-PS-401, p.4-20
     /
  'ELSE'/
   'LPSET1',1.1/
     /
  'ENDIF'/
  /
 
'IF','LPSET'/** PRESURIZER LEVEL SETPOINT
 12.48/      **  Change from 12.28
  'IF LTCL4 THEN'/
   'LPSET4'/
     /
  'ELSE'/
   'LPSET1'/
     /
  'ENDIF'/
  /
 
'* CALCULATE FLOW THROUGH THE HTS LOOPS BOTH PUMPS OPERATING'/
 
'LOGICAL OPERATION','LF1'/
'OR'/
   'LWG1'/
   'LWG2'/
   /
/
 
'LOGICAL OPERATION','LF2'/
'OR'/
   'LWG3'/
   'LWG4'/
   /
/
 
'CALCULATE','F10'/ MASS FLOW RATE (LBM/S) THROUGH HTS LOOP1 (WGi<=0)
'ENTER'/           ** from 86-PS-401, p.4-4
   'HC1',-0.4301/
   'HC2',-0.4301/
   'HR1',-0.1608/
   'HR2',-0.1608/
   'CONSTANT(5174.0)'/
   /
'STORE'/
/
 
'CALCULATE','F11'/ MASS FLOW RATE (LBM/S) THROUGH HTS LOOP1 (WGi>0)
'ENTER'/           ** from 86-PS-401, p.4-4
   'F10'/
   'WG1',-591.0/
   'WG2',-591.0/
   /
'STORE'/
/
 
'IF','F1'/(JHKIM CHANGE FROM ASSIGN)
4688.80/ ** Should Be Checked or Redifined Based on CATHENA Run for Initial Value
'IF LF1 THEN'/
   'F11'/
   /
'ELSE'/
   'F10'/
   /
'ENDIF'/
/
 
'CALCULATE','F20'/ MASS FLOW RATE (LBM/S) THROUGH HTS LOOP2 (WGi<=0)
'ENTER'/
   'HC3',-0.4301/
   'HC4',-0.4301/
   'HR3',-0.1608/
   'HR4',-0.1608/
   'CONSTANT(5174.0)'/
   /
'STORE'/
/
 
'CALCULATE','F21'/ MASS FLOW RATE (LBM/S) THROUGH HTS LOOP2 (WGi>0)
'ENTER'/
   'F20'/
   'WG3',-591.0/
   'WG4',-591.0/
   /
'STORE'/
/
 
'IF','F2'/(JHKIM CHANGE FROM ASSIGN)
4688.20/  ** Should Be Checked or Redefined Based on CATHENA Run for Initial Value
'IF LF2 THEN'/
   'F21'/
   /
'ELSE'/
   'F20'/
   /
'ENDIF'/
/
 
'** PRESSURIZER HEATER MODEL'/***HTC1 MODIFICATIONS***
 
