'COMPARE'/
        'TCEA'/
    /
'LT'/
   'CONSTANT(0.05)'/
    /
/
 
'IF', 'TCEM'/(JHKIM CHANGE FROM ASSIGN)
0.0/
'IF LTCEM THEN'/
        'CONSTANT(0.00)'/
        /
'ELSE'/
        'TCE'/
        /
'ENDIF'/
/
 
