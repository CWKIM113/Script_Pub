'INCLUDE sc_bl_4.inp, _#_=3'/
'INCLUDE sc_bl_4.inp, _#_=4'/
 
'*====================================*'/
'*     CHECK FOR FW FLOW LIMITING     *'/
'*====================================*'/
'*--- CONDITION 2 ---*'/
'LOGICAL','L1FWFL'/   2 SIGNALS ARE BETWEEN 1.125 AND 1.161
'AND',2/
     'LWF1'/
     'LWF2'/
     'LWF3'/
     'LWF4'/
     /
/
 
'*--- CONDITION 1 ---*'/
'LOGICAL','LFWF'/    3 SIGNALS ARE LARGER THAN 1.161 (IRRATIONAL)
'AND',3/
     'L3WF1'/
     'L3WF2'/
     'L3WF3'/
     'L3WF4'/
     /
/
 
'LOGICAL','LLPB'/
'COMPARE'/
     'PB'/
     /
'GT'/
     'CONSTANT(0.05)'/
     /
/
 
'LOGICAL','LPSTM'/
'COMPARE'/
     'PSTM'/
     /
'LT'/
     'CONSTANT(4.137E6)'/
     /
/
 
'LOGICAL','L2FWFL'/
'AND'/
     'LFWF'/
     'LLPB'/
     'LPSTM'/
     /
/
 
'*--- FW FLOW LIMIT INDICATOR ---*'/
'TRIP','LFWFL'/
'OR'/
     'L1FWFL'/               ** (condition 2, 86-63620-PS-202, page 2-8)
     'L2FWFL'/               ** (condition 1, 86-63620-PS-202, page 2-7)
     /
/
/
 
'*=========================================*'/
'*            MASS BALANCE TERM            *'/
'*=========================================*'/
'*--- STEAM AND FW FLOW CHECK 01 ---*'/
'* CHECK STEAM AND FEED WATER FLOW'/
'CALCULATE','AVGWF'/    AVERAGE FEEDWATER FLOW (AVGWF)
'ENTER'/
   'WF1'/
   'WF2'/
   'WF3'/
   'WF4'/
   /
'DIVIDE'/
   'CONSTANT(4.0)'/
   /
'STORE'/
/
 
'CALCULATE','AVGWS'/   CALCULATE AVERAGE STEAM FLOW (AVGWS)
'ENTER'/
   'WSS1'/
   'WSS2'/
   'WSS3'/
   'WSS4'/
   /
'DIVIDE'/
   'CONSTANT(4.0)'/
   /
'STORE'/
/
 
 
'LOGICAL','LAVGWS'/   IF AVERAGE OF 4 STEAM FLOW RATES IS < 20%, NO MASS BALANCE TERM (WSF)
'COMPARE'/            WSF APPROACHES 0
   'AVGWS'/
   /
'LT'/
   'CONSTANT(0.2)'/
   /
/
 
'*--- STEAM AND FW FLOW CHECK 02, 03 & 04 ---*'/
'INCLUDE sc_bl_6.inp, _#_=1'/
'INCLUDE sc_bl_6.inp, _#_=2'/
'INCLUDE sc_bl_6.inp, _#_=3'/
'INCLUDE sc_bl_6.inp, _#_=4'/
 
'*--- WEIGHTING FACTOR FOR STEAM AND FW FLOW TERM ---*'/
'CALCULATE','EALPHA'/
'ENTER'/
     'CONSTANT(0.25)'/       (86-63620-PS-202 Rev.09, page 2-6 (0.5 -> 0.25))
     /
'STORE'/
/
 
'*--- STEAM AND FW FLOW CHECK INDICATORS ---*'/
'LOGICAL OPERATION','LLDIFWS'/ check if more than two of the normalized steam flow(WSS) > 0.1 from the average (AVGWS)
'AND',3/                       then mass balance term(WSF) is not used.
   'LDIFWS1'/
   'LDIFWS2'/
   'LDIFWS3'/
   'LDIFWS4'/
   /
/
 
'LOGICAL OPERATION','LLWSSA'/ check if any one of the normalized steam flow(WSSA) is less than 20%.
'OR'/
   'LWSSA1'/
   'LWSSA2'/
   'LWSSA3'/
   'LWSSA4'/
   /
/
 
'LOGICAL OPERATION','LDFSPC'/   WSF APPROACHES 0
'OR'/
   'LDFSPA1'/
   'LDFSPA2'/
   'LDFSPA3'/
   'LDFSPA4'/
   /
/
 
'LOGICAL OPERATION','LDFPFC'/   WSF APPROACHES 0
'OR'/
   'LDFPF1'/
   'LDFPF2'/
   'LDFPF3'/
   'LDFPF4'/
   /
/
 
'LOGICAL OPERATION','LDFRSC'/  WSF APPROACHES 0
'AND',3/
   'LDFRS1'/
   'LDFRS2'/
   'LDFRS3'/
   'LDFRS4'/
   /
/
 
'*--- CALCULATE MASS BALANCE TERM (WSF) ---*'/
'LOGICAL OPERATION','LWSF'/ if any of these LOGICAL control models are true,
'OR'/                       MASS BALANCE TERM will not be used.
   'LAVGWS'/
   'LLDIFWS'/
   'LLWSSA'/
   'LDFSPC'/
   'LDFPFC'/
   'LDFRSC'/
   /
/
 
