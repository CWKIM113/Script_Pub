/
 
'*==========================================*'/
'*  EFFICIENCY CONTROL FOR STEAM SEPARATOR  *'/
'*==========================================*'/
'CALCULATE','SEPEFF1'/
'PROGRAM'/
C
C THIS SETS EFFICIENCY TO 1.0 BELOW 150% FLOW
C TO 0.0 ABOVE 200% FLOW
C BETWEEN 1 AND 0 BETWEEN 150% AND 200% FLOW
C
            STMFLOW1="MFLO:R-SDRT1>L-STLF1"		
            IF(STMFLOW1 .LT. 387.75)THEN
            SEPEFF1 = 1.0
            ELSEIF (STMFLOW1 .GT. 517.0)THEN
            SEPEFF1 = 0.0
            ELSE
            SEPEFF1 = (517.0-STMFLOW1)/129.25
            ENDIF
            END
'SSSEP1','SEP_EFF'/
'SSSDN1','SEP_EFF'/
/
 
'CALCULATE','SEPEFF2'/
'PROGRAM'/
C
C THIS SETS EFFICIENCY TO 1.0 BELOW 150% FLOW
C TO 0.0 ABOVE 200% FLOW
C BETWEEN 1 AND 0 BETWEEN 150% AND 200% FLOW
C
            STMFLOW2="MFLO:R-SDRT2>L-STLF2"		
            IF(STMFLOW2 .LT. 387.75)THEN
            SEPEFF2 = 1.0
            ELSEIF (STMFLOW2 .GT. 517.0)THEN
            SEPEFF2 = 0.0
            ELSE
            SEPEFF2 = (517.0-STMFLOW2)/129.25
            ENDIF
            END
'SSSEP2','SEP_EFF'/
'SSSDN2','SEP_EFF'/
/
 
'CALCULATE','SEPEFF3'/
'PROGRAM'/
C
C THIS SETS EFFICIENCY TO 1.0 BELOW 150% FLOW
C TO 0.0 ABOVE 200% FLOW
C BETWEEN 1 AND 0 BETWEEN 150% AND 200% FLOW
C
            STMFLOW3="MFLO:R-SDRT3>L-STLF3"		
            IF(STMFLOW3 .LT. 387.75)THEN
            SEPEFF3 = 1.0
            ELSEIF (STMFLOW3 .GT. 517.0)THEN
            SEPEFF3 = 0.0
            ELSE
            SEPEFF3 = (517.0-STMFLOW3)/129.25
            ENDIF
            END
'SSSEP3','SEP_EFF'/
'SSSDN3','SEP_EFF'/
/
 
'CALCULATE','SEPEFF4'/
'PROGRAM'/
C
C THIS SETS EFFICIENCY TO 1.0 BELOW 150% FLOW
C TO 0.0 ABOVE 200% FLOW
C BETWEEN 1 AND 0 BETWEEN 150% AND 200% FLOW
C
            STMFLOW4="MFLO:R-SDRT4>L-STLF4"		
            IF(STMFLOW4 .LT. 387.75)THEN
            SEPEFF4 = 1.0
            ELSEIF (STMFLOW4 .GT. 517.0)THEN
            SEPEFF4 = 0.0
            ELSE
            SEPEFF4 = (517.0-STMFLOW4)/129.25
            ENDIF
            END
'SSSEP4','SEP_EFF'/
'SSSDN4','SEP_EFF'/
/
 
