'COMPARE'/
  'ISOTDV'/
/
'LT'/
  'CONSTANT(14.5)'/
   /
/ NO APPLICATION POINT
 
'*========================================*'/
'*         CALCULATE BLEED FLOW           *'/
'*========================================*'/
