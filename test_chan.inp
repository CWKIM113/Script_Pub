'*--- CALCULATE PRESSURE ERROR ---*'/
'CONTROL DEVICE','BPE'/
'P',1.0E-03/
-500,500/
'PSTM',-1.0/
'CONSTANT(4.593E6)'/ ** KDW(8602-63614-PS-200, Rev.06, page 1-1, changed from 4592.0 kPa(g))
/
/
 
'*--- CALCULATE STEAM PRESSURE RATE OF CHANGE ---*'/
'CONTROL DEVICE', 'DPSTM'/ ** KDW(DPSTM = RATE OF CHANGE IN PRESSURE ERROR)
'P',1.0E-03/               ** KDW(rate of chage in pressure error = -(rate of change in steam pressure))
/
        'PSTM'       , 0.15/
        'PSTM:(N-3)' ,-0.15/
        'PSTM:(N-1)' , 0.05/
        'PSTM:(N-2)' ,-0.05/
        /
/
 
'*--- CALCULATE REACTOR POWER RATE OF CHANGE ---*'/
'CONTROL DEVICE', 'DPR'/ ** KDW(DPR = RATE OF CHANGE IN POWER(%/sec))
'D',100.0, ,1.0/
/
     'PB'/               ** KDW(PB = steam generoator power)
     /
/
 
'CONTROL DEVICE', 'TCE'/
'P', 1.0/                ** (8602-63614-PS-200, Rev.06, page 2-14)
-5.0,2.2/
        'BPE' ,0.01/
        'DPSTM' ,-0.07/
        'DPR' ,0.7/
        /
/
 
