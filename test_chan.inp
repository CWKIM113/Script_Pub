'ENTER'/
   'CONSTANT(5.0)'/
   /
'STORE'/
   /
 
'CALCULATE','FFLOW'/   FFLOW = MAXIMUM FEED FLOW (KG/S)
'ENTER'/
   'CONSTANT(18.90)'/   ** from 86-DM-33300/63330-000, p.A-103
   /
'STORE'/
   /
 
'CONTROL DEVICE','FVOF'/ calculation of feed valve open fraction for 'solid mode' (SEO)
'P',1.0,,,,,/
0.0,1.0/
   'ROHMXA',-5.5556/
   'POHSET',5.5556/
   /
/ NO APPLICATION POINT
 
'DEFINE','FDOPEN'/
0.0/
 
'CONTROL DEVICE','FDO'/ FEED VALVE PROPORTIONAL OPENING
'P',1.0,,,,,/           ** from 86-PS-401, p.2-10
0.0,1.0/
   'PLERR',3.29/
   'CONSTANT(0.07)',3.29/
   /
/ NO APPLICATION POINT
 
'CALCULATE','FDOPEN'/ FDOPEN = PROPORTIONAL VALVE OPENING LIMITED BY TIME CONSTANT
'ENTER'/
   'FDO'/
   'FDOPEN',-1.0/
   /
'MULTIPLY'/
   'TIMESTEP:'/
   /
'DIVIDE'/
   'TAUFDV'/
   /
'ADD'/
   'FDOPEN'/
   /
'STORE'/
/
 
'CALCULATE','WFEED'/ WFEED = FEED FLOW (KG/S)
'ENTER'/
   'FDOPEN'/
   /
'MULTIPLY'/
   'FFLOW'/
   /
'ADD'/
   'CONSTANT(1.24)'/    ** Bypass Flow from 86-DM-33300/63330-000, p.3-5
   /
'MULTIPLY'/
   'CONSTANT(9.99E06)'/
   /
'DIVIDE'/
   'ROHMXA',1.0E6/
   /
'STORE'/
/
 
'*---------------------------------------------------------------------------*'/
'CALCULATE','WFEEDSM'/ FEED FLOW for 'solid mode' (SEO)
'ENTER'/
   'FVOF'/
   /
'MULTIPLY'/
   'FFLOW'/
   /
'STORE'/
/
'*---------------------------------------------------------------------------*'/

'IF', 'FEEDF'/(JHKIM CHANGE FROM ASSIGN)
0.0/
  'IF SOLIDMO THEN'/ (SEO)
    'WFEEDSM'/
   /
  'ELSEIF LFEEDF THEN'/
    'WFEED'/
   /
  'ELSE'/
    'CONSTANT(1.24)'/  ** Bypass Flow from 86-DM-33300/63330-000, p.3-5
   /
'ENDIF'/
/ NO APPLICATION POINT
 
 
'IF','FEEDFL1'/         **  Divided 'FEEDFL' into 'FEEDFL1' & 'FEEDFL2'
    1.24/
  'IF 180LTCL4 THEN'/   **  Add for the restoration of Class III power to the feed pump
    'FEEDF'/            ** The same with W-1 Model
      /
  'ELSEIF LTCL4 THEN'/  **  Change from PWRTRP .AND. LTCL4
     'CONSTANT(0.0)'/
      /
  'ELSE'/
     'FEEDF'/
      /
  'ENDIF'/
/
 
'IF','FEEDFL2'/        **  Divided 'FEEDFL' into 'FEEDFL1' & 'FEEDFL2'
    1.24/
  'IF LFEEDTP THEN'/   ** D2O Storage Tank low Inventory
    'CONSTANT(0.0)'/            ** The same with W-1 Model
      /
  'ELSE'/
     'FEEDFL1'/
      /
  'ENDIF'/
/
'CONTROL DEVICE','FEEDL'/
'P',,,,,,/
'F-B-MULT'/
0.0,18.9/
   'FEEDFL2'/
   /
