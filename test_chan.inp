'COMPARE'/
   'PLERR'/
   /
'LT'/
  'CONSTANT(-0.07)'/           ** from 86-PS-401, p.A-13(Figure 9)
   /
/
 
'LOGICAL','LLPSET'/
'COMPARE'/
   'PWRDWN'/
   /
'GT'/
   'CONSTANT(0.1)'/
   /
/ NO APPLICATION POINT
 
'CALCULATE','TAUBLV'/    TAUBLV = OPENING VALVE TIME CONSTANT(2 sec) / Should Be Checked
'ENTER'/
   'CONSTANT(2.0)'/
   /
'STORE'/
   /
 
'CALCULATE','BFLOW'/  BFLOW = MAXIMUM BLEED FLOW (KG/S)
'ENTER'/
   'CONSTANT(12.85)'/     ** from 86-DM-33300/63330-000, p.A-108
   /
'STORE'/
   /
 
'CONTROL DEVICE','BVOF'/ calculation of Bleed valve open fraction for 'solid mode' (SEO)
'P',1.0,,,,,/
0.0,1.0/
   'ROHMXA',3.8461/
   'POHSET',-3.8461/
   /
/ NO APPLICATION POINT

'CONTROL DEVICE','BVO1'/  ** from 86-PS-401, p.2-10
'P',1.0,,,,,/
-0.5, 0.0/
'PLERR', 4.83/
'CONSTANT(0.07)',4.83/
/
/ NO APPLICATION POINT
 
'CONTROL DEVICE','BVO2'/  ** from 86-PS-401, p.2-10
'P', 1.0,,,,,/
-1.0,0.0/
'PLERR',4.83/
'CONSTANT(0.07)',4.83/
/
/ NO APPLICATION POINT
 
'DEFINE','BVOPEN'/
0.0/
 
'IF','BVO'/(JHKIM CHANGE FROM ASSIGN)
0.0/
'IF LLPSET THEN'/
   'BVO1'/
   /
'ELSE'/
   'BVO2'/
   /
'ENDIF'/
/ NO APPLICATION POINT
 
'CALCULATE','BVOPEN'/ BVOPEN = PROPORTIONAL VALVE OPENING
'ENTER'/
   'BVO'/
   'BVOPEN', -1.0/
   /
'MULTIPLY'/
   'TIMESTEP:'/
   /
'DIVIDE'/
   'TAUBLV'/
   /
'ADD'/
   'BVOPEN'/
   /
'STORE'/
/ NO APPLICATION POINT
 
'CALCULATE','WBLD'/ WBLD = BLEED FLOW (KG/S)
'ENTER'/
   'BVOPEN'/
   /
'MULTIPLY'/
   'BFLOW'/
   /
'ADD'/
   'CONSTANT(-2.06)'/        **  Change from -2.0686 Based on DM-86-33300/63330-000, p.3-5
   /                         ** The Flow Through Orifice Bypassing the Bleed Valve
'MULTIPLY'/
   'ROHMXA',1.0E6/
   /
'DIVIDE'/
   'CONSTANT(9.99E06)'/
   /
'STORE'/
/
 
'*-------------------------------------------------------------------------------------*'/
'CALCULATE','WBLDSM'/ BLEED FLOW for 'solid mode' (SEO)
'ENTER'/
   'BVOF'/
   /
'MULTIPLY'/
   'BFLOW',-1.0/
   /
'STORE'/
/
'*-------------------------------------------------------------------------------------*'/

'IF','BLEEDF'/
      -2.06/                 **  Change from -2.0686 Based on DM-86-33300/63330-000, p.3-5
      'IF SOLIDMO THEN'/ (SEO)
          'WBLDSM'/
           /
      'ELSEIF LBLEEDF THEN'/     **  Delete "BLEEDF=0 IF LFEEDTP = TRUE" Same with W-1 Model
          'WBLD'/
           /
      'ELSE'/
          'CONSTANT(-2.06)'/ **  Change from -2.0686 Based on DM-86-33300/63330-000, p.3-5
           /
      'ENDIF'/
/ NO APPLICATION POINTS
 
 
'CONTROL DEVICE','BLEEDL'/
'P', ,,,,,,/
'F-B-MULT'/
-12.85,0.0/
   'BLEEDF'/
   /
